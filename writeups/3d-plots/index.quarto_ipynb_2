        "---\n",
        "title: \"Using Python to Plot... Whatever's Going On in 3D\"\n",
        "subtitle: \"DSAN 5300: Statistical Learning\"\n",
        "author: \"Jeff Jacobs\"\n",
        "affiliation: \"[`jj1088@georgetown.edu`](mailto:jj1088@georgetown.edu)\"\n",
        "sidebar: mainnav\n",
        "weeknum: 3\n",
        "assignment: \"General\"\n",
        "cache: true\n",
        "term: current\n",
        "categories:\n",
        "  - \"Extra Writeups\"\n",
