        "#| label: training-data-plot\n",
        "#| fig-align: center\n",
        "from sklearn.preprocessing import PolynomialFeatures\n",
        "x = np.arange(0, 1, 0.1)\n",
        "n = len(x)\n",
        "eps = rng.normal(size=n, loc=0, scale=0.04)\n",
        "y = x + eps\n",
        "# But make one big outlier\n",
